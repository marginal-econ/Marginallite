# Browser-safe Supabase configuration for authentication and RLS requests.
VITE_BACKEND_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_BACKEND_PUBLISHABLE_KEY="sb_publishable_..."

# Server-side configuration for privileged admin functions.
BACKEND_URL="https://YOUR_PROJECT_REF.supabase.co"
BACKEND_PUBLISHABLE_KEY="sb_publishable_..."
BACKEND_SERVICE_ROLE_KEY="sb_secret_..."

# Canonical public origin used for invitation and password-setup links.
PUBLIC_SITE_URL="https://your-domain.example"

# Server-only waitlist API configuration. These may point to the same project.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
WAITLIST_ADMIN_KEY="replace-with-a-long-random-value"

# Mailjet email verification for public waitlist signups. The sender address
# must be validated in Mailjet before OTP messages can be delivered.
MAILJET_API_KEY="your-mailjet-api-key"
MAILJET_SECRET_KEY="your-mailjet-secret-key"
MAILJET_SENDER_EMAIL="your-verified-sender@example.com"
# Generate with: openssl rand -hex 32
WAITLIST_OTP_SECRET="replace-with-64-random-hex-characters"

# Comma-separated list of administrative emails
ADMIN_EMAILS="marginal.econ.ai@gmail.com"

# Optional quiet rate limits for abuse prevention (per user per hour)
RATE_LIMIT_ESSAY_PER_HOUR=30
RATE_LIMIT_VISION_PER_HOUR=60
